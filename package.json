{
  "name": "shady-meadows-bnb-automation",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation portfolio for the Shady Meadows B&B application",
    "scripts": {
    "clean:reports": "rm -rf cypress/reports cypress/screenshots",
    "test": "npm run test:regression",
    "test:regression": "npm run clean:reports && cypress run --spec \"cypress/e2e/public/homepage/**/*.cy.js\"",
    "test:defects": "npm run clean:reports && cypress run --spec \"cypress/e2e/known-defects/homepage/**/*.cy.js\"",
    "report:open": "open cypress/reports/index.html"
  },
  "devDependencies": {
    "axe-core": "^4.11.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^5.0.0"
  }
}
